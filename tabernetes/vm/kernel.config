# The kernel of a pod that runs in v86 (Dockerfile): tinyconfig for i386 and
# what a container needs on top of it. v86 emulates a Pentium-class PC with a
# serial port and virtio devices.
CONFIG_64BIT=n
CONFIG_X86_32=y
CONFIG_M686=y
CONFIG_SMP=n
CONFIG_HIGHMEM4G=n
CONFIG_NOHIGHMEM=y
CONFIG_PRINTK=y
CONFIG_EARLY_PRINTK=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_POSIX_TIMERS=y
CONFIG_FILE_LOCKING=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_IPV6=n
CONFIG_PCI=y
CONFIG_PCI_GOANY=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
# The root file system: the layers of the image over 9p (web/src/rootfs.js).
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_9P_FS=y
CONFIG_ACPI=n
CONFIG_MODULES=n
CONFIG_KALLSYMS=n
CONFIG_DEBUG_INFO_NONE=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_KERNEL_GZIP=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_SYSVIPC=y
CONFIG_X86_TSC=y
CONFIG_INPUT=n
CONFIG_VT=n
CONFIG_RTC_CLASS=n
CONFIG_IP_PNP=y
# tinyconfig turns these off. Without the system calls with a 32 bit time_t,
# glibc ends a program with "The futex facility returned an unexpected error
# code": Debian images need them, musl (Alpine) does not.
CONFIG_COMPAT_32BIT_TIME=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_INOTIFY_USER=y
CONFIG_FHANDLE=y
CONFIG_HIGH_RES_TIMERS=y
